BOT_TOKEN=
CHAT_ID=

# Session configuration
SESSION_TIMEOUT_MINUTES=30
USERS_DB_PATH=users.db

# Bootstrap admin user (used only if admin user does not already exist in DB)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Cloudflared config paths
CLOUDFLARED_CONFIG_PATH=/home/suharyaseen0/.cloudflared/config.yml
CLOUDFLARED_FALLBACK_CONFIG_PATH=/home/user/test/cloudflared/config.yml
CLOUDFLARED_TUNNEL_NAME=myvm-tunnel
CLOUDFLARED_DNS_AUTO_ROUTE=true

# AI Assistant Provider (gemini or nvidia)
AI_PROVIDER=gemini

# Gemini AI Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# NVIDIA AI Assistant (OpenAI-compatible API)
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_AUTO_REMEDIATION=false
AI_CONFIRM_SENSITIVE=true
AI_RATE_LIMIT_PER_MIN=10
AI_MAX_CONVERSATION_MESSAGES=50